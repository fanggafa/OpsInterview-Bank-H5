{
  "name": "ops-interview-h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "运维面试题库 H5 应用（OpsInterview Bank）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "node scripts/validate-data.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:figures": "node scripts/check-figure-text.mjs",
    "verify": "npm run check:encoding && npm run validate:data && npm run check:figures && npm run check:import-case && npm run check:figure-sfc && npm run check:figure-placement && npm run test && npm run build",
    "check:import-case": "node scripts/check-import-case.mjs",
    "check:figure-sfc": "node scripts/check-figure-sfc.mjs",
    "check:figure-placement": "node scripts/check-figure-placement.mjs"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
